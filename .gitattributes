# Normalize text files. Files that run on Cradle (Linux) MUST keep LF endings,
# even when edited on Windows; CRLF breaks bash/sbatch ("bad interpreter: /bin/bash^M").
* text=auto
*.sh      text eol=lf
*.sbatch  text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf

# Windows-only scripts
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Unreal binary assets -> Git LFS
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
